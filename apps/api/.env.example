NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ogfi:ogfi_dev_password@localhost:5432/ogfi_inventory?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-access-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ALTCHA_HMAC_SECRET=replace-with-altcha-hmac-secret
ALTCHA_COST=8000
ALTCHA_KEY_PREFIX_LENGTH=2
CORS_ORIGIN=http://localhost:3001
ENABLE_SWAGGER=false

# Local development seed account only. Override these in apps/api/.env.
SEED_ADMIN_EMAIL=admin@ogfi.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-local-dev-password

# Optional local break-glass account for resetting/unlocking restricted admins.
# Leave password empty/undefined to skip creating this account.
SEED_DEV_SUPER_EMAIL=dev.super@ogfi.local
SEED_DEV_SUPER_USERNAME=dev-super
SEED_DEV_SUPER_PASSWORD=
